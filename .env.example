# Build defaults for this BITWINEX Pro archive.
VITE_BRAND=bitwinex
VITE_SKIN=okx
VITE_SITE_DOMAIN=exchange.invalid

# Override with the target exchange's settings in .env.local.
VITE_WALLET_API_BASE=
VITE_API_RSA_PUBLIC_KEY=

# Products that are announced but not open yet show a "coming soon" page. Set a line to 1 once its backend is live.
# Futures quotes, chart and order book are always visible; VITE_OPEN_FUTURES_TRADING only opens order entry.
VITE_OPEN_FUTURES_TRADING=
VITE_OPEN_COPY_TRADING=
VITE_OPEN_EARN=
VITE_OPEN_LOANS=
VITE_OPEN_LAUNCHPAD=
VITE_OPEN_LAUNCHPOOL=
VITE_OPEN_VESTING=
# C2C / OTC desk: entries and pages are hidden unless this is 1.
VITE_OPEN_OTC=
